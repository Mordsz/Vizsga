[sub_resource type="CSharpScript" id="CSharpScript_bmkdx"]
script/source = "using Godot;
using System;

public partial class Inventory : CanvasLayer
{
	// Called when the node enters the scene tree for the first time.

	private const int InvSize = 16; // Inventory mérete
	public override void _Ready()
	{
		Visible = false; // Kezdetben legyen rejtett az inventory
		var grid = GetNode<GridContainer>(\"Inv\"); 
		
		for (int i = 0; i < InvSize; i++)
		{
			var slot = (InventorySlot)GD.Load<PackedScene>(\"res://Scripts/Inventory/InventorySlot.tscn\").Instantiate();
			slot.Init(ItemData.ItemType.Consumable, new Vector2(32, 32)); // vagy a megfelelő típust add meg
			grid.AddChild(slot);
		}
			
	}

	// Called every frame. 'delta' is the elapsed time since the previous frame.
	public override void _Process(double delta)
	{
		if (Input.IsActionJustPressed(\"ui_inventory\"))
		{
			Visible = !Visible;
		}
	}
}
"

